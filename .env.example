VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# One or more subnets to scan, separated by commas (CIDR /16 to /32)
SCAN_SUBNET=192.168.1.0/24
# Optional: full path to nmap. Defaults to the standard Nmap install on Windows, or ./nmap on Linux
NMAP_PATH=
# Optional: TP-Link / Kasa app account, needed for Kasa switches on the encrypted KLAP protocol.
# Read only by the dev server (no VITE_ prefix), so it is never sent to the browser.
KASA_USERNAME=
KASA_PASSWORD=
