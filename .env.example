VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# One or more subnets to scan, separated by commas (CIDR /16 to /32)
SCAN_SUBNET=192.168.1.0/24
# Optional: full path to nmap. Defaults to the standard Nmap install on Windows, or ./nmap on Linux
NMAP_PATH=
# Optional: TP-Link / Kasa app account, needed for Kasa switches on the encrypted KLAP protocol.
# Read only by the dev server (no VITE_ prefix), so it is never sent to the browser.
KASA_USERNAME=
KASA_PASSWORD=
# Optional: Resideo (Honeywell Home) developer app credentials, needed for the T9 thermostat.
# From https://developer.honeywellhome.com → My Apps. Read only by the dev server (no VITE_ prefix).
RESIDEO_CLIENT_ID=
RESIDEO_CLIENT_SECRET=
# Must exactly match the Callback URL configured on the app in the developer portal.
RESIDEO_REDIRECT_URI=http://localhost:8080/api/resideo/callback
# Optional: Voice Monkey (voicemonkey.io), needed for Alexa announcements.
# Read only by the dev server (no VITE_ prefix).
VOICEMONKEY_TOKEN=
# Device ID of a Voice Monkey "Speaker" device, used when a call doesn't specify one.
VOICEMONKEY_DEVICE_ID=
